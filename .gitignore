.venv/
__pycache__/
*.pyc

# Настройки IDE — машинно-специфичные.
# .claude/ наоборот в репозитории: там скилл перевода, он общий.
.idea/

# Оригинальные игровые файлы — не в репозиторий (большие + чужие).
# Правило по расширениям однажды пропустило backup/data.unity3d на 129 МБ,
# поэтому игнорируется всё, кроме манифеста.
backup/*
!backup/manifest.json

# Извлечённые сырые ассеты — воспроизводятся из игры через tools/extract.py
work/raw/
work/build/
work/build_assets/
work/localized/

# Переносимый комплект — это копии игровых файлов (110 МБ, с графикой 3 ГБ).
# Собирается заново одной командой: tools/make_installer.py
dist/

# Экспорт системного хранилища сертификатов, машинно-специфичный
tools/win-ca-bundle.pem

# Картинки, выгруженные из игры для перерисовки — чужие пиксели, в репозиторий
# им нельзя (то же правило, что для backup/ и dist/). Собираются заново:
# tools/export_localized.py + сборщик из docs/localized-assets.md.
# Промпт и манифест — наши, они остаются.
work/graphics_en/**/*.png
work/graphics_ru/**/*.png

# Надписи от нейросети — она рисовала их по игровому образцу, то есть это
# производное от чужих пикселей. В репозиторий им нельзя по той же причине.
# Приходят от пользователя, кладутся в work/graphics_ai/<дело>/, задание
# на вклейку (art.json) — наше, оно остаётся.
work/graphics_ai/**/*.png
