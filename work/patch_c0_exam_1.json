{
"exam.bytes|FFFFFFFF|0": "И всё же меня выслушают!",
"exam.bytes|FFFFFFFF#2|0": "Вы правда думаете, что я отступлю?",
"exam.bytes|FFFFFFFF#3|0": "Они связаны с этим местом?",
"exam.bytes|FFFFFFFF#4|0": "Что, земля под ногами загорелась?",
"exam.bytes|FFFFFFFF#5|0": "Мне стыдиться нечего.",
"exam.bytes|FFFFFFFF#6|0": "Это вам должно быть стыдно!",
"exam.bytes|FFFFFFFF#7|0": "Она стреляла в вас снаружи самолёта?",
"exam.bytes|FFFFFFFF#8|0": "Вы правда думаете, что я подчинюсь?",
"exam.bytes|FFFFFFFF#9|0": "А мне ещё есть что сказать!",
"exam.bytes|FFFFFFFF#10|0": "Разумеется, преступница — она!",
"exam.bytes|FFFFFFFF#11|0": "Отдайте — или пойдёте под арест!",
"exam.bytes|FFFFFFFF#12|0": "Значит, вы слышали выстрелы?",
"exam.bytes|FFFFFFFF#13|0": "У вас должна быть запись репортажа!",
"exam.bytes|FFFFFFFF#14|0": "Буду звать вас барышней сколько захочу!",
"exam.bytes|FFFFFFFF#15|0": "Ваш диктофон меня не интересует!",
"exam.bytes|FFFFFFFF#16|0": "Включите запись!",
"exam.bytes|FFFFFFFF#17|0": "Вы явно что-то скрываете!",
"exam.bytes|FFFFFFFF#18|0": "Так что там про «сенсации»?",
"exam.bytes|FFFFFFFF#19|0": "Готовьтесь — прямой справа!",
"exam.bytes|FFFFFFFF#20|0": "О, поверьте, ещё как!",
"exam.bytes|FFFFFFFF#21|0": "Я думал, вы человек невозмутимый?",
"exam.bytes|FFFFFFFF#22|0": "Ну? Отвечайте!",
"exam.bytes|FFFFFFFF#23|0": "Откуда вы знаете, кто я по профессии?",
"exam.bytes|FFFFFFFF#24|0": "Что, уже выдохлись?",
"exam.bytes|FFFFFFFF#25|0": "Не прикидывайтесь!",
"exam.bytes|FFFFFFFF#26|0": "Вы разминались!",
"exam.bytes|FFFFFFFF#27|0": "Хм. Как грубо.",
"exam.bytes|FFFFFFFF#28|0": "«Уже», говорите?",
"exam.bytes|FFFFFFFF#29|0": "Хороший человек — и в тюрьме?",
"exam.bytes|FFFFFFFF#30|0": "Вы, кажется, сердитесь, мистер Видалл.",
"exam.bytes|FFFFFFFF#31|0": "«Тот, кто нашёл тело», говорите?",
"exam.bytes|FFFFFFFF#32|0": "Что вы делали?",
"exam.bytes|FFFFFFFF#33|0": "Что творилось в тюрьме?",
"exam.bytes|FFFFFFFF#34|0": "Они кричали?",
"exam.bytes|FFFFFFFF#35|0": "Они смеялись?",
"exam.bytes|FFFFFFFF#36|0": "Вы говорили, что слышали крик!",
"exam.bytes|FFFFFFFF#37|0": "Спокойнее, спокойнее!",
"exam.bytes|FFFFFFFF#38|0": "Это вы их напугали?",
"exam.bytes|FFFFFFFF#39|0": "Крик их, конечно, напугал бы.",
"exam.bytes|FFFFFFFF#40|0": "Довольно этой фальшивой улыбки!",
"exam.bytes|FFFFFFFF#41|0": "Ну и ну, кто-то не помнит себя от злости.",
"exam.bytes|FFFFFFFF#42|0": "И вы на этом ките катались?",
"exam.bytes|FFFFFFFF#43|0": "Вы ведь не были на представлении?",
"exam.bytes|FFFFFFFF#44|0": "Ни на каком представлении вы не были!",
"exam.bytes|FFFFFFFF#45|0": "Ну и прекрасно! Мы закончили!",
"exam.bytes|FFFFFFFF#46|0": "Постойте, кричал не потерпевший?",
"exam.bytes|FFFFFFFF#47|0": "Потому что тело нашли вы!",
"exam.bytes|FFFFFFFF#48|0": "Потому что потерпевший — вы!",
"exam.bytes|FFFFFFFF#49|0": "Именно так я и думаю!",
"exam.bytes|FFFFFFFF#50|0": "Это и так одни каракули.",
"exam.bytes|FFFFFFFF#51|0": "А у этих людей попросту нет вкуса.",
"exam.bytes|FFFFFFFF#52|0": "Почему было не прийти вместе!?",
"exam.bytes|FFFFFFFF#53|0": "Значит, ты здесь ради статуи Близнецов?",
"exam.bytes|FFFFFFFF#54|0": "Тебе не дали буклет?",
"exam.bytes|FFFFFFFF#55|0": "Ты не платил за вход?",
"exam.bytes|FFFFFFFF#56|0": "Мисс Долговой не было за стойкой?",
"exam.bytes|FFFFFFFF#57|0": "А ты немало знаешь о Зимнем крыле...",
"exam.bytes|FFFFFFFF#58|0": "То есть внутрь ты не заходил?",
"exam.bytes|FFFFFFFF#59|0": "Потерпевший тебя не пустил?",
"exam.bytes|FFFFFFFF#60|0": "И где же твой набросок?",
"exam.bytes|FFFFFFFF#61|0": "Значит, ты видел нечто «совсем ужасное»?",
"exam.bytes|FFFFFFFF#62|0": "Что, слишком усердно моргал?",
"exam.bytes|FFFFFFFF#63|0": "Что, сам не мог?",
"exam.bytes|FFFFFFFF#64|0": "Проснись!",
"exam.bytes|FFFFFFFF#65|0": "Признай: тебе было не выиграть.",
"exam.bytes|FFFFFFFF#66|0": "Поверю, когда увижу.",
"exam.bytes|FFFFFFFF#67|0": "Значит, книга занимала и вас?",
"exam.bytes|FFFFFFFF#68|0": "Вы знаете больше, чем говорите.",
"exam.bytes|FFFFFFFF#69|0": "Вот только вы знали, что там не то!",
"exam.bytes|FFFFFFFF#70|0": "Вы метили в фармацевты!",
"exam.bytes|FFFFFFFF#71|0": "Вам нужно было лекарство, верно?",
"exam.bytes|FFFFFFFF#72|0": "Что-то мне не верится.",
"exam.bytes|FFFFFFFF#73|0": "Значит, он был не так уж болен?",
"exam.bytes|FFFFFFFF#74|0": "Но вам была дорога работа мистера Тангароа!",
"exam.bytes|FFFFFFFF#75|0": "Но жизни это не угрожало, верно?",
"exam.bytes|FFFFFFFF#76|0": "У него было расстройство вкуса?",
"exam.bytes|FFFFFFFF#77|0": "У него был лишний вес?",
"exam.bytes|FFFFFFFF#78|0": "Вы и сами были больны, верно?",
"exam.bytes|FFFFFFFF#79|0": "Должно быть, зрелище было ещё то!",
"exam.bytes|FFFFFFFF#80|0": "Но вы же работали с мистером Морозовым!?",
"exam.bytes|FFFFFFFF#81|0": "Вашу ученицу я знаю неплохо."
}
