{
"exam.bytes|FFFFFFFF#82|0": "У вас ведь есть сенсация, не так ли?",
"exam.bytes|FFFFFFFF#83|0": "Вы ведь шли в школу, верно?",
"exam.bytes|FFFFFFFF#84|0": "На спокойного вы не похожи!",
"exam.bytes|FFFFFFFF#85|0": "Перестану, когда вы и правда успокоитесь!",
"exam.bytes|FFFFFFFF#86|0": "Она была вашей ученицей.",
"exam.bytes|FFFFFFFF#87|0": "Она была вашей сестрой.",
"exam.bytes|FFFFFFFF#88|0": "Вы что-то слышали от мисс Ллойд?",
"exam.bytes|FFFFFFFF#89|0": "Значит, какой-то звук вы всё же слышали?",
"exam.bytes|FFFFFFFF#90|0": "Вы пробрались тайком — вот это и беда!",
"exam.bytes|FFFFFFFF#91|0": "Вот и пробирались бы в другое место!",
"exam.bytes|FFFFFFFF#92|0": "Так вы совершили убийство?",
"exam.bytes|FFFFFFFF#93|0": "Значит, ваша сенсация — про убийство?",
"exam.bytes|FFFFFFFF#94|0": "Но что-то вы всё-таки слышали?",
"exam.bytes|FFFFFFFF#95|0": "А я думал, вы «честнее всех на свете»?",
"exam.bytes|FFFFFFFF#96|0": "Что вы там бормочете!?",
"exam.bytes|FFFFFFFF#97|0": "И вы можете это доказать?",
"exam.bytes|FFFFFFFF#98|0": "Вы точно что-то ещё скрываете!",
"exam.bytes|FFFFFFFF#99|0": "Это мне впору сердиться!",
"exam.bytes|FFFFFFFF#100|0": "Извольте! Сердитесь дальше!",
"exam.bytes|FFFFFFFF#101|0": "Я прокурор!",
"exam.bytes|FFFFFFFF#102|0": "Я заключённый!",
"exam.bytes|FFFFFFFF#103|0": "И что с того!?",
"exam.bytes|FFFFFFFF#104|0": "Это было бы к лучшему!",
"exam.bytes|FFFFFFFF#105|0": "Может, лучше это оставить...",
"exam.bytes|FFFFFFFF#106|0": "«Продвигается неплохо»...?",
"exam.bytes|FFFFFFFF#107|0": "Нет, я ставлю вас на место!",
"exam.bytes|FFFFFFFF#108|0": "Посмотрю я, как у вас выйдет!",
"exam.bytes|FFFFFFFF#109|0": "Думаете, мне сейчас есть дело до своей судьбы?",
"exam.bytes|FFFFFFFF#110|0": "Не припомню, чтобы вверял вам свою судьбу!",
"exam.bytes|FFFFFFFF#111|0": "«Решение принято»...?",
"exam.bytes|FFFFFFFF#112|0": "Сейчас я не отступлю!",
"exam.bytes|FFFFFFFF#113|0": "Что вы задумали её арест!",
"exam.bytes|FFFFFFFF#114|0": "Без этого значка мне не жить!",
"exam.bytes|FFFFFFFF#115|0": "Да и не нужен мне этот значок!",
"exam.bytes|FFFFFFFF#116|0": "Кто отдал приказ?",
"exam.bytes|FFFFFFFF#117|0": "На каком основании?",
"exam.bytes|FFFFFFFF#118|0": "А улики вы запомнили отменно!",
"exam.bytes|FFFFFFFF#119|0": "Вы, разумеется!",
"exam.bytes|FFFFFFFF#120|0": "Судья Молотова!",
"exam.bytes|FFFFFFFF#121|0": "А что с моим терпением?",
"exam.bytes|FFFFFFFF#122|0": "О, вы не знаете, каким грубым я бываю.",
"exam.bytes|FFFFFFFF#123|0": "Вы надеетесь увести разговор от дела.",
"exam.bytes|FFFFFFFF#124|0": "Вы пытаетесь меня разжалобить.",
"exam.bytes|FFFFFFFF#125|0": "То же самое я скажу о вас.",
"exam.bytes|FFFFFFFF#126|0": "А у меня есть отличное объяснение!",
"exam.bytes|FFFFFFFF#127|0": "Зато все прочие мелочи дела вы знаете!",
"exam.bytes|FFFFFFFF#128|0": "Извольте, подражайте мне и дальше!",
"exam.bytes|FFFFFFFF#129|0": "Мною вам не стать!",
"exam.bytes|FFFFFFFF#130|0": "«Навесить на неё»...?",
"exam.bytes|FFFFFFFF#131|0": "Эта улика ничего не доказывает.",
"exam.bytes|FFFFFFFF#132|0": "Что это вы вдруг притихли?",
"exam.bytes|FFFFFFFF#133|0": "Осторожнее с зажигалкой!",
"exam.bytes|FFFFFFFF#134|0": "А ведь вы всё твердите, что заняты...",
"exam.bytes|FFFFFFFF#135|0": "Вы правда всё это прочли?",
"exam.bytes|FFFFFFFF#136|0": "Вы видели, где именно её нашли?",
"exam.bytes|FFFFFFFF#137|0": "А какая в тот день была погода?",
"exam.bytes|FFFFFFFF#138|0": "Вот только я знаю: это не она!",
"exam.bytes|FFFFFFFF#139|0": "Я лично знаком с президентом!",
"exam.bytes|FFFFFFFF#140|0": "Утром вы нам помогли!",
"exam.bytes|FFFFFFFF#141|0": "Виновны и вы, и обвиняемая!",
"exam.bytes|FFFFFFFF#142|0": "Вы тревожитесь и о ком-то ещё?",
"exam.bytes|FFFFFFFF#143|0": "Вы не прислуга — вы человек!",
"exam.bytes|FFFFFFFF#144|0": "И вы просто его бросите?",
"exam.bytes|FFFFFFFF#145|0": "Испытание? Это мучение!",
"exam.bytes|FFFFFFFF#146|0": "Это Юстас у вас «бедное дитя»?",
"exam.bytes|FFFFFFFF#147|0": "«Бедное дитя»? О ком вы?",
"exam.bytes|FFFFFFFF#148|0": "Что-то не так с тем, как он умер?",
"exam.bytes|FFFFFFFF#149|0": "Что-то не так с тем, где он умер?",
"exam.bytes|FFFFFFFF#150|0": "Его нашёл кто-то из съёмочной группы.",
"exam.bytes|FFFFFFFF#151|0": "Вас тревожат сборы?",
"exam.bytes|FFFFFFFF#152|0": "«Бедное дитя» пропало, не так ли?",
"exam.bytes|FFFFFFFF#153|0": "Это кто-то из фильма, верно?",
"exam.bytes|FFFFFFFF#154|0": "«Непревзойдённый»? Не уверен...",
"exam.bytes|FFFFFFFF#155|0": "На вас это мало похоже...",
"exam.bytes|FFFFFFFF#157|0": "Вы и впрямь одержимы, да?",
"exam.bytes|FFFFFFFF#158|0": "Что он любит, а что нет?",
"exam.bytes|FFFFFFFF#159|0": "Мне до него совершенно нет дела.",
"exam.bytes|FFFFFFFF#160|0": "Вы наверняка с ним говорили!",
"exam.bytes|FFFFFFFF#161|0": "Вас двоих очень многое связывает!",
"exam.bytes|FFFFFFFF#162|0": "Тот, кто за ним гнался?",
"exam.bytes|FFFFFFFF#163|0": "Тот, кто его похитил?",
"exam.bytes|FFFFFFFF#164|0": "Верно! Не стану!",
"exam.bytes|FFFFFFFF#165|0": "Могу сделать вид, что слушаю!",
"exam.bytes|FFFFFFFF#166|0": "Протестую!",
"exam.bytes|FFFFFFFF#167|0": "Постойте!",
"exam.bytes|FFFFFFFF#168|0": "У вас что-то украли?",
"exam.bytes|FFFFFFFF#169|0": "Ах, какое горе.",
"exam.bytes|FFFFFFFF#170|0": "Нужно верить в себя!",
"exam.bytes|FFFFFFFF#171|0": "Верить вовсе не обязательно!",
"exam.bytes|FFFFFFFF#172|0": "Вы, вероятно, хотели сказать «некомпетентен».",
"exam.bytes|FFFFFFFF#173|0": "Вы даже этого не знаете!?",
"exam.bytes|FFFFFFFF#174|0": "Никакая вы не жертва!",
"exam.bytes|FFFFFFFF#175|0": "Дайте мне хоть что-нибудь!",
"exam.bytes|FFFFFFFF#176|0": "Владелец? Юстас Победин?",
"exam.bytes|FFFFFFFF#177|0": "Владелец? Эксцельсиус Победин?",
"exam.bytes|FFFFFFFF#178|0": "За вашим похищением стоял ваш отец!",
"exam.bytes|FFFFFFFF#179|0": "Разумеется, нет!",
"exam.bytes|FFFFFFFF#180|0": "Возможно...",
"exam.bytes|FFFFFFFF#181|0": "У вашего отца был не тот мотив!",
"exam.bytes|FFFFFFFF#182|0": "О чём они вас спрашивали?",
"exam.bytes|FFFFFFFF#183|0": "Вы им всё и облегчили.",
"exam.bytes|FFFFFFFF#184|0": "Вы обо мне?",
"exam.bytes|FFFFFFFF#185|0": "Вы о своём отце?",
"exam.bytes|FFFFFFFF#186|0": "Вы НЕ дотягиваете!",
"exam.bytes|FFFFFFFF#187|0": "Нет, зато Я дотягиваю!",
"exam.bytes|FFFFFFFF#188|0": "Готов поспорить, что глупость несусветная.",
"exam.bytes|FFFFFFFF#189|0": "Это я уже знаю.",
"exam.bytes|FFFFFFFF#190|0": "Вы хотели попасть в Комитет?",
"exam.bytes|FFFFFFFF#191|0": "Вы хотели, чтобы отец вас одобрил?",
"exam.bytes|FFFFFFFF#192|0": "Потому что хотите быть полезны отцу.",
"exam.bytes|FFFFFFFF#193|0": "Потому что вы ненавидите отца.",
"exam.bytes|FFFFFFFF#194|0": "Это невозможно!",
"exam.bytes|FFFFFFFF#195|0": "Правильно — «ОБЕЛИТЬ его имя»!",
"exam.bytes|FFFFFFFF#196|0": "Что ещё вы помните?",
"exam.bytes|FFFFFFFF#197|0": "Разумеется, так и было!",
"exam.bytes|FFFFFFFF#198|0": "Вы ей завидуете!?",
"exam.bytes|FFFFFFFF#199|0": "Вы ему совсем не нравитесь, верно?",
"exam.bytes|FFFFFFFF#200|0": "Не желаю слушать оправдания!",
"exam.bytes|FFFFFFFF#201|0": "Нет! Теперь вы выслушаете МЕНЯ!",
"exam.bytes|FFFFFFFF#202|0": "Улику вы отдали отцу!",
"exam.bytes|FFFFFFFF#203|0": "Он хотел выставить вас на посмешище!",
"exam.bytes|FFFFFFFF#204|0": "Он хотел сорвать процесс!",
"exam.bytes|FFFFFFFF#205|0": "Вы хотели сказать «милосердие»?",
"exam.bytes|FFFFFFFF#206|0": "От меня милосердия не ждите!",
"exam.bytes|FFFFFFFF#207|0": "Я могу стать для вас таким человеком.",
"exam.bytes|FFFFFFFF#208|0": "Стало быть, нет?",
"exam.bytes|FFFFFFFF#209|0": "На это ответите только вы!",
"exam.bytes|FFFFFFFF#210|0": "Нет, не стоит!",
"exam.bytes|FFFFFFFF#211|0": "Правильно — «по одёжке встречают».",
"exam.bytes|FFFFFFFF#212|0": "Думаю, мне это вполне пойдёт.",
"exam.bytes|FFFFFFFF#213|0": "Не спешите радоваться.",
"exam.bytes|FFFFFFFF#214|0": "О, смеяться над вами всё равно будут.",
"exam.bytes|FFFFFFFF#215|0": "Вы станете другим прокурором."
}
